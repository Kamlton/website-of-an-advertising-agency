{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "node", 
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "../ui-library/node_modules/@types"],
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@my-app/ui-library": ["../ui-library/src/index.ts"],
      "@my-app/ui-library/*": ["../ui-library/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}